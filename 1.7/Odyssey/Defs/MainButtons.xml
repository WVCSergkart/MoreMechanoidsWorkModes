	<label>mechs work</label>
	<description>Choose which mech does what kinds of work, and in what order.</description>
	<workerClass>WVC_WorkModes.MainButtonWorker_ToggleMechTab</workerClass>
	<tabWindowClass>WVC_WorkModes.MainTabWindow_Work_Mechs</tabWindowClass>
	<buttonVisible>true</buttonVisible>
