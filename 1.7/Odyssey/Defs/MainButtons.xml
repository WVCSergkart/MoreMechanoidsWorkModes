	  <li>WVC_AllowShutdown</li>
	  <li>WVC_RestrictShutdown</li>
	  <li>WVC_AssignEscort</li>
	  <li>GapTiny</li>
	  <li>GapTiny</li>
	  <li>CopyPasteWorkPriorities</li>
	  <li>RemainingSpace</li>
	</columns>
  </PawnTableDef>

  <PawnColumnDef>
	<defName>WVC_CopyPasteAllMechsWork</defName>
	<workerClass>WVC_WorkModes.PawnColumnWorker_CopyPasteAllMechsWork</workerClass>
  </PawnColumnDef>

